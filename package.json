{
  "name": "sqlloom",
  "version": "0.3.0",
  "description": "Find race conditions in your SQL transactions: runs every interleaving on a real Postgres at every isolation level and shows the one that corrupts your data.",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "typecheck": "tsc -p .",
    "examples": "for f in examples/*.mjs examples/*.sql; do node bin/sqlloom.js $f; done",
    "pretest": "prisma generate --schema examples/orm/prisma/schema.prisma >/dev/null"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "transactions",
    "isolation-level",
    "race-condition",
    "concurrency",
    "testing",
    "serializable",
    "write-skew",
    "lost-update"
  ],
  "author": "Anime5hka",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "pg": "^8.23.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "sqlloom": "bin/sqlloom.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anime5hka/sqlloom.git"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/node": "^26.6.6",
    "drizzle-orm": "^0.45.4",
    "knex": "^3.3.0",
    "kysely": "^0.29.9",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
